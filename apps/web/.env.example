# Copy to apps/web/.env  (never commit the real .env). Only VITE_* variables reach the browser —
# never put secrets here.

# Base URL the browser uses for API calls. Keep "/api" in development: Vite proxies it to the API.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (dev only, not exposed to the browser).
API_PROXY_TARGET=http://localhost:3000
