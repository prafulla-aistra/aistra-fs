# apps/api/.env is created from this file automatically on the first "npm run dev".
# Edit apps/api/.env (never commit it) to change a setting.

# HTTP
PORT=3000
# Comma-separated list of browser origins allowed to call the API directly.
# (In development the web app proxies /api through Vite, so CORS is rarely needed.)
CORS_ORIGINS=http://localhost:5173

# Database — the ONLY setting to change when moving to AWS RDS.
#   localhost  -> "npm run dev" runs the embedded PostgreSQL 16 server (npm package
#                 embedded-postgres) on this port, with these credentials, storing data in
#                 ./data/db. Nothing to install. Port 54329 avoids clashing with a normal
#                 PostgreSQL on 5432.
#   any other host -> that server is used as-is, e.g. AWS RDS:
#     postgresql://USER:PASSWORD@my-db.xxxx.ap-south-1.rds.amazonaws.com:5432/finance_close?sslmode=require
DATABASE_URL=postgresql://finance:finance_dev_password@localhost:54329/finance_close?schema=public

# File storage for uploads, behind StorageService.
#   local  files in STORAGE_LOCAL_DIR (relative to the repo root)
#   (s3    AWS S3 — added in a later step)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads

# Authentication
# Secret for signing access tokens. Leave empty here: a random value is generated into
# apps/api/.env on first run. In AWS, set it from Secrets Manager (32+ random characters).
JWT_SECRET=
# How long a login lasts without activity (refresh-token lifetime, hours).
REFRESH_TOKEN_TTL_HOURS=12
# true whenever the app is served over HTTPS (any deployed environment).
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Master admin, created by the seed if it does not exist yet. The seed never overwrites
# the password of an existing master; to reset it to MASTER_PASSWORD run
# "npm run master:reset-password". Password rule: 10+ characters, a letter and a number.
# CHANGE THESE before using the app with real data. Wrap a value in quotes if it contains #.
MASTER_NAME=Master admin
MASTER_EMAIL=master@financeclose.local
MASTER_PASSWORD=FinanceClose-2026
