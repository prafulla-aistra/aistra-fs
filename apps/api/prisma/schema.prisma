// Finance Close — database schema (PostgreSQL 16)
//
// Conventions (see CLAUDE.md):
//   - Money amounts: Decimal @db.Decimal(20, 4)   -> NUMERIC(20,4)
//   - Exchange rates: Decimal @db.Decimal(20, 10) -> NUMERIC(20,10)
//   - Never Float / Double for money or rates.
//   - Sign convention: debit = positive, credit = negative.
//   - Tables are snake_case; Prisma models are PascalCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Configuration: currencies, entities and group structure (step 2)
// ---------------------------------------------------------------------------

model Currency {
  /// ISO 4217 code, e.g. "INR".
  code      String   @id @db.Char(3)
  name      String   @db.VarChar(100)
  symbol    String   @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  functionalFor Entity[]                   @relation("FunctionalCurrency")
  reportingFor  Entity[]                   @relation("ReportingCurrency")
  translatedFor EntityTranslatedCurrency[]
  historicalFor EntityHistoricalRate[]
  exchangeRates ExchangeRate[]

  @@map("currency")
}

enum ErpSystem {
  ZOHO
  XERO
  OTHER
}

enum Gaap {
  IND_AS
  IFRS
  US_GAAP
  UK_GAAP
  OTHER
}

model Entity {
  code               String    @id @db.VarChar(10)
  legalName          String    @map("legal_name") @db.VarChar(200)
  /// Used in lists and as the consolidation level name, e.g. "Veracity Services".
  shortName          String    @map("short_name") @db.VarChar(60)
  country            String    @db.VarChar(60)
  functionalCurrency String    @map("functional_currency") @db.Char(3)
  reportingCurrency  String    @map("reporting_currency") @db.Char(3)
  parentCode         String?   @map("parent_code") @db.VarChar(10)
  /// % of this entity held by its parent (0.01–100); null for the ultimate parent.
  heldByParentPct    Decimal?  @map("held_by_parent_pct") @db.Decimal(7, 4)
  erp                ErpSystem
  gaap               Gaap
  isActive           Boolean   @default(true) @map("is_active")
  toBeConfirmed      Boolean   @default(false) @map("to_be_confirmed")
  toBeConfirmedNote  String?   @map("to_be_confirmed_note") @db.VarChar(500)
  /// Date of incorporation or acquisition.
  incorporatedOn     DateTime? @map("incorporated_on") @db.Date
  /// Variance flags ignore movements below this amount (functional currency).
  materiality        Decimal?  @db.Decimal(20, 4)
  /// Display order (lists, group tree, level members).
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  functional           Currency                   @relation("FunctionalCurrency", fields: [functionalCurrency], references: [code])
  reporting            Currency                   @relation("ReportingCurrency", fields: [reportingCurrency], references: [code])
  parent               Entity?                    @relation("EntityParent", fields: [parentCode], references: [code], onDelete: Restrict)
  children             Entity[]                   @relation("EntityParent")
  translatedCurrencies EntityTranslatedCurrency[]
  historicalRates      EntityHistoricalRate[]
  userScopes           UserEntityScope[]
  taskEntities         TaskEntity[]
  accounts             EntityAccount[]            @relation("EntityAccounts")
  counterpartyAccounts EntityAccount[]            @relation("AccountCounterparty")
  uploadedFiles        UploadedFile[]             @relation("UploadedFileEntity")
  uploadProfile        UploadProfile?             @relation("UploadProfileEntity")
  ownership            EntityOwnership[]          @relation("OwnershipEntity")
  ownedEntities        EntityOwnership[]          @relation("OwnershipParent")
  levelCurrency        LevelCurrencyOverride?

  @@map("entity")
}

/// Currencies an entity's statements are translated into (never its functional currency).
model EntityTranslatedCurrency {
  entityCode   String @map("entity_code") @db.VarChar(10)
  currencyCode String @map("currency_code") @db.Char(3)

  entity   Entity   @relation(fields: [entityCode], references: [code])
  currency Currency @relation(fields: [currencyCode], references: [code])

  @@id([entityCode, currencyCode])
  @@map("entity_translated_currency")
}

/// Historical rate for equity (share capital, premium): 1 unit of functional currency = rate target.
model EntityHistoricalRate {
  entityCode     String   @map("entity_code") @db.VarChar(10)
  targetCurrency String   @map("target_currency") @db.Char(3)
  rate           Decimal  @db.Decimal(20, 10)
  toBeConfirmed  Boolean  @default(true) @map("to_be_confirmed")
  note           String?  @db.VarChar(300)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity   Entity   @relation(fields: [entityCode], references: [code])
  currency Currency @relation(fields: [targetCurrency], references: [code])

  @@id([entityCode, targetCurrency])
  @@map("entity_historical_rate")
}

/// Statement format (layout of the statements a task produces). Minimal for page 2; the
/// Formats configuration screen maintains it later.
model Format {
  code        String   @id @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String   @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tasks        Task[]
  lastChoiceOf User[]

  @@map("format")
}

// ---------------------------------------------------------------------------
// Financial-year calendar and due dates (step 2)
// ---------------------------------------------------------------------------

enum PeriodType {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum StatementType {
  SFS
  CFS
}

model FinancialYear {
  id          String       @id @default(uuid()) @db.Uuid
  /// Calendar year the FY starts in: 2026 = FY 2026-27 (April 2026 – March 2027).
  startYear   Int          @unique @map("start_year")
  label       String       @db.VarChar(20)
  /// A closed financial year accepts no new tasks.
  status      PeriodStatus @default(OPEN)
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User?    @relation("FinancialYearCreatedBy", fields: [createdById], references: [id])
  periods   Period[]

  @@map("financial_year")
}

model Period {
  id                String       @id @default(uuid()) @db.Uuid
  financialYearId   String       @map("financial_year_id") @db.Uuid
  type              PeriodType
  /// 1–12 for months (1 = April), 1–4 for quarters, 1 for the year.
  sequence          Int
  label             String       @db.VarChar(30)
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  /// Closed periods cannot have new tasks.
  status            PeriodStatus @default(OPEN)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(3)
  statusChangedById String?      @map("status_changed_by_id") @db.Uuid

  financialYear    FinancialYear     @relation(fields: [financialYearId], references: [id])
  statusChangedBy  User?             @relation("PeriodStatusChangedBy", fields: [statusChangedById], references: [id])
  dueDateOverrides DueDateOverride[]
  tasks            Task[]

  @@unique([financialYearId, type, sequence])
  @@index([startDate])
  @@map("period")
}

/// Working days after period end for each task type (e.g. monthly SFS = 7).
model DueDateRule {
  statementType StatementType @map("statement_type")
  periodType    PeriodType    @map("period_type")
  workingDays   Int           @map("working_days")
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([statementType, periodType])
  @@map("due_date_rule")
}

/// Non-working days (in addition to Saturdays and Sundays).
model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @unique @db.Date
  description String   @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("holiday")
}

/// A due date set by hand for one period and statement type, with the reason.
model DueDateOverride {
  periodId      String        @map("period_id") @db.Uuid
  statementType StatementType @map("statement_type")
  dueDate       DateTime      @map("due_date") @db.Date
  reason        String        @db.VarChar(500)
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  period    Period @relation(fields: [periodId], references: [id])
  createdBy User   @relation("DueDateOverrideCreatedBy", fields: [createdById], references: [id])

  @@id([periodId, statementType])
  @@map("due_date_override")
}

// ---------------------------------------------------------------------------
// Users and permissions (permission-based; no hard-coded roles)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String     @db.VarChar(200)
  /// Login id. Always stored lower-case and trimmed.
  email              String     @unique @db.VarChar(320)
  passwordHash       String     @map("password_hash") @db.VarChar(100)
  status             UserStatus @default(ACTIVE)
  /// The master admin: every permission, cannot be deleted or deactivated.
  isMaster           Boolean    @default(false) @map("is_master")
  /// Seeded demo account (demo mode only). Only these can use quick login.
  isDemo             Boolean    @default(false) @map("is_demo")
  /// True after an admin sets a temporary password; cleared when the user changes it.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// When false, access is limited to the entities in UserEntityScope.
  allEntities        Boolean    @default(true) @map("all_entities")
  /// Template last applied as a starting point (permissions may since have been adjusted).
  templateCode       String?    @map("template_code") @db.VarChar(40)
  /// Format this user chose last in the new-task wizard (the wizard's default).
  lastFormatCode     String?    @map("last_format_code") @db.VarChar(40)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Bumped on password change/reset and deactivation; access tokens carry it, so older
  /// tokens stop working immediately.
  sessionVersion     Int        @default(1) @map("session_version")
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?               @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]              @relation("UserCreatedBy")
  template      PermissionTemplate? @relation(fields: [templateCode], references: [code])
  lastFormat    Format?             @relation(fields: [lastFormatCode], references: [code])
  permissions   UserPermission[]
  entityScopes  UserEntityScope[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  financialYearsCreated FinancialYear[]         @relation("FinancialYearCreatedBy")
  periodStatusChanges   Period[]                @relation("PeriodStatusChangedBy")
  dueDateOverrides      DueDateOverride[]       @relation("DueDateOverrideCreatedBy")
  tasksCreated          Task[]                  @relation("TaskCreatedBy")
  taskEntitiesFinalised TaskEntity[]            @relation("TaskEntityFinalisedBy")
  taskLevelsFinalised   TaskLevel[]             @relation("TaskLevelFinalisedBy")
  accountsUpdated       EntityAccount[]         @relation("EntityAccountUpdatedBy")
  ratesEntered          ExchangeRate[]          @relation("ExchangeRateEnteredBy")
  filesUploaded         UploadedFile[]          @relation("UploadedFileBy")
  tbVersionsCreated     TbVersion[]             @relation("TbVersionCreatedBy")
  uploadProfiles        UploadProfile[]         @relation("UploadProfileUpdatedBy")
  varianceExplanations  VarianceExplanation[]   @relation("VarianceExplanationBy")
  ownershipChanges      EntityOwnership[]       @relation("OwnershipCreatedBy")
  levelCurrencies       LevelCurrencyOverride[] @relation("LevelCurrencyBy")

  @@map("app_user")
}

model Permission {
  code        String @id @db.VarChar(40)
  description String @db.VarChar(300)
  /// UI grouping, e.g. "Administration", "Standalone statements".
  area        String @db.VarChar(60)
  sortOrder   Int    @default(0) @map("sort_order")

  users     UserPermission[]
  templates PermissionTemplatePermission[]

  @@map("permission")
}

model PermissionTemplate {
  code        String @id @db.VarChar(40)
  name        String @db.VarChar(100)
  description String @db.VarChar(300)
  sortOrder   Int    @default(0) @map("sort_order")

  permissions PermissionTemplatePermission[]
  users       User[]

  @@map("permission_template")
}

model PermissionTemplatePermission {
  templateCode   String @map("template_code") @db.VarChar(40)
  permissionCode String @map("permission_code") @db.VarChar(40)

  template   PermissionTemplate @relation(fields: [templateCode], references: [code], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionCode], references: [code])

  @@id([templateCode, permissionCode])
  @@map("permission_template_permission")
}

model UserPermission {
  userId         String   @map("user_id") @db.Uuid
  permissionCode String   @map("permission_code") @db.VarChar(40)
  grantedAt      DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([userId, permissionCode])
  @@map("user_permission")
}

model UserEntityScope {
  userId     String @map("user_id") @db.Uuid
  entityCode String @map("entity_code") @db.VarChar(10)

  user   User   @relation(fields: [userId], references: [id])
  entity Entity @relation(fields: [entityCode], references: [code])

  @@id([userId, entityCode])
  @@map("user_entity_scope")
}

// ---------------------------------------------------------------------------
// Sessions: refresh tokens (only a SHA-256 hash is stored, never the token)
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ip        String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_token")
}

// ---------------------------------------------------------------------------
// Audit log — append-only, reused by every later step.
// ---------------------------------------------------------------------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  /// Who did it. Null when unknown (e.g. a failed login for an email that does not exist).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?  @db.VarChar(64)

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Close tasks (page 1: dashboard). A task prepares SFS for entities or CFS for levels in one
// period. Task status is DERIVED from its items (engine deriveTaskStatus), never stored.
// ---------------------------------------------------------------------------

enum TaskItemStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  FINALISED
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  /// e.g. SFS-2026-08-001
  number           String           @unique @db.VarChar(30)
  type             StatementType
  /// Financial year and period type come from the period.
  periodId         String           @map("period_id") @db.Uuid
  /// Statement format. Required for new tasks (older demo rows may have none).
  formatCode       String?          @map("format_code") @db.VarChar(40)
  /// Optional note from the preparer to the reviewer.
  reviewerNote     String?          @map("reviewer_note") @db.VarChar(1000)
  description      String           @db.VarChar(300)
  dueDate          DateTime         @map("due_date") @db.Date
  /// Workflow step the task was left at (the task workspace defines the steps).
  currentStep      String           @map("current_step") @db.VarChar(40)
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set when every entity/level is finalised; the task is then locked.
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  /// Demo data (seeded only in demo mode; removable with npm run demo:remove-tasks).
  isDemo           Boolean          @default(false) @map("is_demo")
  /// Comparatives step: which period the task is compared with.
  comparativeBasis ComparativeBasis @default(PREVIOUS_PERIOD) @map("comparative_basis")

  period               Period                @relation(fields: [periodId], references: [id])
  format               Format?               @relation(fields: [formatCode], references: [code])
  createdBy            User                  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  entities             TaskEntity[]
  levels               TaskLevel[]
  files                UploadedFile[]
  varianceExplanations VarianceExplanation[]
  translationSnapshots TranslationSnapshot[]
  mappedAccounts       EntityAccount[]
  tbVersions           TbVersion[]

  @@index([periodId])
  @@map("task")
}

model TaskEntity {
  taskId        String         @map("task_id") @db.Uuid
  entityCode    String         @map("entity_code") @db.VarChar(10)
  status        TaskItemStatus @default(NOT_STARTED)
  currentStep   String         @map("current_step") @db.VarChar(40)
  finalisedById String?        @map("finalised_by_id") @db.Uuid
  finalisedAt   DateTime?      @map("finalised_at") @db.Timestamptz(3)
  /// Retained-earnings roll-forward check, stored when the comparatives step is completed
  /// (read by the translation step).
  rollForward   Json?          @map("roll_forward")

  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entity      Entity @relation(fields: [entityCode], references: [code])
  finalisedBy User?  @relation("TaskEntityFinalisedBy", fields: [finalisedById], references: [id])

  @@id([taskId, entityCode])
  @@map("task_entity")
}

/// A consolidation level of a CFS task, snapshotted from the group structure at creation.
model TaskLevel {
  taskId           String         @map("task_id") @db.Uuid
  level            Int
  name             String         @db.VarChar(60)
  parentEntityCode String         @map("parent_entity_code") @db.VarChar(10)
  currency         String         @db.Char(3)
  /// Member entity codes at creation (parent first).
  members          String[]
  status           TaskItemStatus @default(NOT_STARTED)
  currentStep      String         @map("current_step") @db.VarChar(40)
  finalisedById    String?        @map("finalised_by_id") @db.Uuid
  finalisedAt      DateTime?      @map("finalised_at") @db.Timestamptz(3)

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  finalisedBy User? @relation("TaskLevelFinalisedBy", fields: [finalisedById], references: [id])

  @@id([taskId, level])
  @@map("task_level")
}

// ---------------------------------------------------------------------------
// Chart of accounts and FSLI master (page 3). Mapping screens come on page 4.
// ---------------------------------------------------------------------------

enum FsliStatement {
  BS
  PL
}

/// A = asset, L = liability, E = equity, I = income, X = expense.
enum FsliClass {
  A
  L
  E
  I
  X
}

/// Translation rate applied to an FSLI (Ind AS 21 / IAS 21, see CLAUDE.md).
enum RateBasis {
  CLOSING
  AVERAGE
  HISTORICAL
  OPENING
  ROLL_FORWARD
  COMPUTED
}

/// Financial statement line item: the group-wide lines every account maps to.
model Fsli {
  code              String        @id @db.VarChar(30)
  name              String        @db.VarChar(120)
  statement         FsliStatement
  class             FsliClass
  rateBasis         RateBasis     @map("rate_basis")
  /// Only produced by consolidation (goodwill, NCI, IC difference); accounts never map to it.
  consolidationOnly Boolean       @default(false) @map("consolidation_only")
  /// Accounts mapped here must name a counterparty entity.
  needsCounterparty Boolean       @default(false) @map("needs_counterparty")
  intercompany      Boolean       @default(false)
  /// Calculated by the system (profit for the period, FCTR); accounts never map to it.
  computed          Boolean       @default(false)
  sortOrder         Int           @default(0) @map("sort_order")
  isActive          Boolean       @default(true) @map("is_active")

  accounts     EntityAccount[]
  typeDefaults AccountTypeDefault[]

  @@map("fsli")
}

/// ERP account type → default FSLI for accounts first seen in a chart-of-accounts upload.
model AccountTypeDefault {
  erp         ErpSystem
  accountType String    @map("account_type") @db.VarChar(60)
  fsliCode    String    @map("fsli_code") @db.VarChar(30)

  fsli Fsli @relation(fields: [fsliCode], references: [code])

  @@id([erp, accountType])
  @@map("account_type_default")
}

enum AccountSource {
  SEED
  COA_UPLOAD
  TASK_MAPPING
}

/// An entity's chart of accounts: each account and the FSLI it maps to.
model EntityAccount {
  id                String        @id @default(uuid()) @db.Uuid
  entityCode        String        @map("entity_code") @db.VarChar(10)
  accountCode       String        @map("account_code") @db.VarChar(40)
  accountName       String        @map("account_name") @db.VarChar(200)
  accountType       String?       @map("account_type") @db.VarChar(60)
  parentAccount     String?       @map("parent_account") @db.VarChar(200)
  fsliCode          String?       @map("fsli_code") @db.VarChar(30)
  counterpartyCode  String?       @map("counterparty_code") @db.VarChar(10)
  rateBasisOverride RateBasis?    @map("rate_basis_override")
  source            AccountSource
  /// The FSLI was suggested automatically (from the name or account type), not yet confirmed.
  suggested         Boolean       @default(true)
  /// Task in which the mapping was set (source TASK_MAPPING): "Mapped in task <number>".
  mappedInTaskId    String?       @map("mapped_in_task_id") @db.Uuid
  updatedById       String?       @map("updated_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity       Entity  @relation("EntityAccounts", fields: [entityCode], references: [code])
  fsli         Fsli?   @relation(fields: [fsliCode], references: [code])
  counterparty Entity? @relation("AccountCounterparty", fields: [counterpartyCode], references: [code])
  updatedBy    User?   @relation("EntityAccountUpdatedBy", fields: [updatedById], references: [id])
  mappedInTask Task?   @relation(fields: [mappedInTaskId], references: [id], onDelete: SetNull)

  @@unique([entityCode, accountCode])
  @@map("entity_account")
}

// ---------------------------------------------------------------------------
// Exchange rates (group level): units of currency per 1 USD, per month.
// ---------------------------------------------------------------------------

model ExchangeRate {
  /// First day of the month.
  month        DateTime @db.Date
  currencyCode String   @map("currency_code") @db.Char(3)
  opening      Decimal? @db.Decimal(20, 10)
  closing      Decimal? @db.Decimal(20, 10)
  average      Decimal? @db.Decimal(20, 10)
  /// Where the figures came from, e.g. "Rate file: rates.xlsx" or "Manual entry".
  source       String   @db.VarChar(200)
  enteredById  String?  @map("entered_by_id") @db.Uuid
  enteredAt    DateTime @default(now()) @map("entered_at") @db.Timestamptz(3)
  /// Set once a report using this month is finalised; locked rates are read-only.
  locked       Boolean  @default(false)

  currency  Currency @relation(fields: [currencyCode], references: [code])
  enteredBy User?    @relation("ExchangeRateEnteredBy", fields: [enteredById], references: [id])

  @@id([month, currencyCode])
  @@map("exchange_rate")
}

// ---------------------------------------------------------------------------
// Uploads (page 3): original files in object storage, trial-balance versions and lines.
// ---------------------------------------------------------------------------

enum UploadKind {
  TB
  COA
  OTHER
  RATES
}

model UploadedFile {
  id           String     @id @default(uuid()) @db.Uuid
  kind         UploadKind
  /// StorageService object key.
  storageKey   String     @unique @map("storage_key") @db.VarChar(400)
  originalName String     @map("original_name") @db.VarChar(255)
  contentType  String     @map("content_type") @db.VarChar(120)
  size         Int
  sha256       String     @db.Char(64)
  taskId       String?    @map("task_id") @db.Uuid
  entityCode   String?    @map("entity_code") @db.VarChar(10)
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entity     Entity?     @relation("UploadedFileEntity", fields: [entityCode], references: [code])
  uploadedBy User        @relation("UploadedFileBy", fields: [uploadedById], references: [id])
  tbVersions TbVersion[]

  @@index([sha256])
  @@index([taskId, entityCode, kind])
  @@map("uploaded_file")
}

enum TbStatus {
  ERROR
  VALIDATED_WITH_WARNINGS
  VALIDATED
}

/// One confirmed trial-balance upload for an entity in a task. Replacing a TB adds a version.
model TbVersion {
  id                   String    @id @default(uuid()) @db.Uuid
  taskId               String    @map("task_id") @db.Uuid
  entityCode           String    @map("entity_code") @db.VarChar(10)
  version              Int
  /// CURRENT = the task period's TB; COMPARATIVE = uploaded on the comparatives step, for
  /// this task only (never the official TB of that period).
  purpose              TbPurpose @default(CURRENT)
  /// The period the TB is for (comparative uploads only; current TBs use the task period).
  periodId             String?   @map("period_id") @db.Uuid
  fileId               String    @map("file_id") @db.Uuid
  status               TbStatus
  debits               Decimal   @db.Decimal(20, 4)
  credits              Decimal   @db.Decimal(20, 4)
  difference           Decimal   @db.Decimal(20, 4)
  lineCount            Int       @map("line_count")
  /// Accounts not in the entity's chart of accounts ([{code, name}]), mapped on the next step.
  newAccounts          Json      @map("new_accounts")
  /// { errors, warnings, info } from the engine parser and the upload checks.
  issues               Json
  /// Column settings used (header row, columns, sign convention).
  settings             Json
  detectedPeriod       Json?     @map("detected_period")
  detectedOrganisation String?   @map("detected_organisation") @db.VarChar(300)
  /// Warning codes the uploader acknowledged (period / organisation mismatch).
  acknowledgements     Json
  createdById          String    @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file      UploadedFile @relation(fields: [fileId], references: [id], onDelete: NoAction)
  createdBy User         @relation("TbVersionCreatedBy", fields: [createdById], references: [id])
  lines     TbLine[]

  @@unique([taskId, entityCode, purpose, version])
  @@map("tb_version")
}

enum TbPurpose {
  CURRENT
  COMPARATIVE
}

enum ComparativeBasis {
  PREVIOUS_PERIOD
  SAME_PERIOD_LAST_YEAR
}

/// Explanation of a flagged variance on the comparatives step (one per task, entity, account).
model VarianceExplanation {
  taskId      String   @map("task_id") @db.Uuid
  entityCode  String   @map("entity_code") @db.VarChar(10)
  accountCode String   @map("account_code") @db.VarChar(40)
  text        String   @db.VarChar(500)
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedBy User @relation("VarianceExplanationBy", fields: [updatedById], references: [id])

  @@id([taskId, entityCode, accountCode])
  @@map("variance_explanation")
}

/// Global settings (key → value), e.g. VARIANCE_PCT_THRESHOLD = 0.20.
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     String   @db.VarChar(200)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_setting")
}

model TbLine {
  id          BigInt  @id @default(autoincrement())
  tbVersionId String  @map("tb_version_id") @db.Uuid
  accountCode String  @map("account_code") @db.VarChar(40)
  accountName String  @map("account_name") @db.VarChar(200)
  /// Debit positive, credit negative.
  amount      Decimal @db.Decimal(20, 4)
  /// 1-based spreadsheet rows (several when duplicate codes were combined).
  sourceRows  Int[]   @map("source_rows")
  zero        Boolean @default(false)
  /// From the TB file's account type column, when it has one.
  accountType String? @map("account_type") @db.VarChar(60)

  tbVersion TbVersion @relation(fields: [tbVersionId], references: [id], onDelete: Cascade)

  @@index([tbVersionId])
  @@map("tb_line")
}

/// Remembered TB column settings per entity, pre-filled on the next upload.
model UploadProfile {
  entityCode  String   @id @map("entity_code") @db.VarChar(10)
  settings    Json
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity    Entity @relation("UploadProfileEntity", fields: [entityCode], references: [code])
  updatedBy User   @relation("UploadProfileUpdatedBy", fields: [updatedById], references: [id])

  @@map("upload_profile")
}

/// A stored translation (step 4 result) of one entity into one currency. Written when the
/// entity is finalised (page 8; the demo Jul-2026 task is seeded with them) and read as the
/// prior period for the retained-earnings roll-forward and the FCTR movement.
model TranslationSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  entityCode     String   @map("entity_code") @db.VarChar(10)
  targetCurrency String   @map("target_currency") @db.Char(3)
  periodId       String   @map("period_id") @db.Uuid
  /// Translated retained earnings, profit and FCTR (signed, credit negative).
  retained       Decimal  @db.Decimal(20, 4)
  profit         Decimal  @db.Decimal(20, 4)
  fctr           Decimal  @db.Decimal(20, 4)
  /// The full engine result (rates, lines, totals, method, warnings).
  result         Json
  /// SEED (demo data) or FINALISE.
  source         String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityCode, targetCurrency])
  @@index([entityCode, targetCurrency, periodId])
  @@map("translation_snapshot")
}

/// Ownership history: the parent and % held from a month onwards. A change of parent or % held
/// adds a row (never overwrites). Structures and consolidation use the row effective for the
/// period; Entity.parentCode / heldByParentPct mirror the row in force this month.
model EntityOwnership {
  id              String   @id @default(uuid()) @db.Uuid
  entityCode      String   @map("entity_code") @db.VarChar(10)
  parentCode      String?  @map("parent_code") @db.VarChar(10)
  heldByParentPct Decimal? @map("held_by_parent_pct") @db.Decimal(7, 4)
  /// First day of the month the row applies from.
  effectiveFrom   DateTime @map("effective_from") @db.Date
  reason          String   @db.VarChar(500)
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entity    Entity  @relation("OwnershipEntity", fields: [entityCode], references: [code])
  parent    Entity? @relation("OwnershipParent", fields: [parentCode], references: [code])
  createdBy User?   @relation("OwnershipCreatedBy", fields: [createdById], references: [id])

  @@unique([entityCode, effectiveFrom])
  @@map("entity_ownership")
}

/// Consolidation level currency set by hand (default: the level parent's reporting currency).
model LevelCurrencyOverride {
  parentEntityCode String   @id @map("parent_entity_code") @db.VarChar(10)
  currency         String   @db.Char(3)
  updatedById      String   @map("updated_by_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity    Entity @relation(fields: [parentEntityCode], references: [code])
  updatedBy User   @relation("LevelCurrencyBy", fields: [updatedById], references: [id])

  @@map("level_currency_override")
}
